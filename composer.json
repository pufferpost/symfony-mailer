{
    "name": "jeroenmoonen/mailer-symfony",
    "description": "Symfony Mailer transport for the EU-first transactional email API (ADR-0037).",
    "type": "library",
    "keywords": ["email", "transactional", "symfony", "mailer", "transport"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "jeroenmoonen/mailer-php": "^0.1",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mailer\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mailer\\Symfony\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
