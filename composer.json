{
    "name": "pufferpost/symfony-mailer",
    "description": "Symfony Mailer transport for the transactional email API.",
    "type": "library",
    "keywords": ["email", "transactional", "symfony", "mailer", "transport"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "pufferpost/sdk": "^0.1",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PufferPost\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PufferPost\\Symfony\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
